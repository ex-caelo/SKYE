---
// The site root. SKYE has no real "homepage" — every real visit arrives at
// /form or /switcher with a formId/siteId/applicationId already in hand (a
// link from SharePoint). entry-index.ts only: (1) forwards a stray
// old-style bare-root-plus-hash link to /form; (2) reveals #state-auth-error
// when an MSAL redirect-fallback dumps an OAuth error on the bare origin.
// Otherwise the static landing section below is all that shows.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="SKYE">
  <section data-state id="state-landing">
    <h1>SKYE</h1>
    <p>
      SKYE renders forms and views defined on a SharePoint site. Use a
      link from your SharePoint site's <code>skye_data</code>
      configuration, or open the <a href="/switcher">site switcher</a> if
      you already know which form you're looking for.
    </p>
  </section>

  <section data-state id="state-auth-error" hidden>
    <h1>Sign-in didn't complete</h1>
    <p><strong data-slot="error"></strong><span data-slot="description"></span></p>
    <p>
      This usually means the Microsoft sign-in/consent flow was cancelled,
      denied, or interrupted before finishing. Go back to the page you came
      from and try again.
    </p>
  </section>

  <script src="../page-scripts/index.ts"></script>
</BaseLayout>
