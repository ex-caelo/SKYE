---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import Loading from "../components/Loading.astro";
---

<BaseLayout title="SKYE — Form">

  <section data-state id="screen-form">
    <a class="skye-form__edit-link" data-el="edit-link" hidden></a>
    <aside class="skye-form__draft-banner" data-slot="draft-banner" hidden></aside>
    <div data-slot="form-mount">
        <div class="skye-form"><h1>Luddy LLC Event Proposal</h1><p class="skye-form__description">Adds the admin-only Approval page. Merged on top of the base form only for users who can open this 'admin' folder in SharePoint.</p><div class="skye-form__tabs"><button type="button" data-page-key="basics" class="skye-form__tab--active">Basics</button><button type="button" data-page-key="metrics">Metrics</button><button type="button" data-page-key="purchases">Purchases</button><button type="button" data-page-key="approval">Approval</button></div><div class="skye-form__page" data-page-key="basics" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; grid-template-areas: &quot;poster eventTitle&quot; &quot;poster eventDescription&quot; &quot;poster eventDescription&quot; &quot;startTime endTime&quot; &quot;location location&quot; &quot;resourcesNote resourcesNote&quot;;"><div class="skye-field skye-field--file" style="grid-area: poster;"><label for="poster">Poster</label><input data-field-key="poster" type="file" accept="image/*" id="poster" name="poster" aria-describedby="poster-message"><div class="skye-field__help">Upload the event poster image. It is saved to Documents / PHOTOS! / Event Posters / 2026-2027 and named after the event.</div><div class="skye-field__message" role="alert" id="poster-message"></div></div><div class="skye-field" style="grid-area: eventTitle;"><label for="eventTitle">Título</label><input data-field-key="eventTitle" type="text" required="" maxlength="255" id="eventTitle" name="Title" aria-describedby="eventTitle-message"><div class="skye-field__message" role="alert" id="eventTitle-message"></div></div><div class="skye-field" style="grid-area: eventDescription;"><label for="eventDescription">Event Description</label><textarea data-field-key="eventDescription" required="" rows="6" id="eventDescription" name="EventDescription" aria-describedby="eventDescription-message"></textarea><div class="skye-field__message" role="alert" id="eventDescription-message"></div></div><div class="skye-field" style="grid-area: startTime;"><label for="startTime">Start Time</label><input data-field-key="startTime" type="datetime-local" required="" id="startTime" name="StartTime" aria-describedby="startTime-message"><div class="skye-field__message" role="alert" id="startTime-message"></div></div><div class="skye-field" style="grid-area: endTime;"><label for="endTime">End Time</label><input data-field-key="endTime" type="datetime-local" required="" id="endTime" name="EndTime" aria-describedby="endTime-message"><div class="skye-field__message" role="alert" id="endTime-message"></div></div><div class="skye-field" style="grid-area: location;"><label for="location">Location</label><skye-multi-select data-field-key="location" required="" id="location" name="Location" aria-describedby="location-message" class="skye-multi-select"><button type="button" class="skye-multi-select__trigger" aria-haspopup="listbox" aria-expanded="false"><span class="skye-multi-select__placeholder">Select options…</span><span class="skye-multi-select__caret">▾</span></button><ul class="skye-multi-select__panel" role="listbox" aria-multiselectable="true" hidden=""><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Makerspace F130</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Reception F134</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Small Conference Room F133</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Luddy Lounge F140</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Kitchen F146</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Teter NST F150</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Large Conference Room F155</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>LLC Classroom F160</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Teter Billiard and Ping Pong Tables</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Teter Activity Room C130</span></li></ul></skye-multi-select><div class="skye-field__help">Choose one or more rooms or areas in the LLC.</div><div class="skye-field__message" role="alert" id="location-message"></div></div><div class="skye-field skye-field--content" style="grid-area: resourcesNote;"><p data-field-key="resourcesNote">Scheduling resources: Event Calendar · Not-Yet-Approved Events · Luddy Class Schedule.   Location resource: LLC Floorplan.</p></div></div><div class="skye-form__page" data-page-key="metrics" style="display: none; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; grid-template-areas: &quot;eventType host&quot; &quot;cohosts photographers&quot; &quot;attire categories&quot; &quot;studentSuccessDomain naceCompetencies&quot; &quot;studentImpact studentImpact&quot;;"><div class="skye-field" style="grid-area: eventType;"><label for="eventType">Event Type</label><select data-field-key="eventType" required="" id="eventType" name="HostRole" aria-describedby="eventType-message"><option value="Peer Mentor or Staff">Peer Mentor or Staff</option><option value="EBOARD">EBOARD</option><option value="Townhall">Townhall</option></select><div class="skye-field__message" role="alert" id="eventType-message"></div></div><div class="skye-field" style="grid-area: host;"><label for="host">Host</label><skye-people-picker data-field-key="host" required="" id="host" name="Host" aria-describedby="host-message" class="skye-token-picker"><div class="skye-token-picker__box"><input class="skye-token-picker__input" type="text" autocomplete="off" placeholder="Type a name or email…"></div><ul class="skye-token-picker__dropdown" hidden=""></ul></skye-people-picker><div class="skye-field__message" role="alert" id="host-message"></div></div><div class="skye-field" style="grid-area: cohosts;"><label for="cohosts">Cohosts</label><skye-people-picker data-field-key="cohosts" id="cohosts" name="Cohosts" aria-describedby="cohosts-message" class="skye-token-picker"><div class="skye-token-picker__box"><input class="skye-token-picker__input" type="text" autocomplete="off" placeholder="Type a name or email…"></div><ul class="skye-token-picker__dropdown" hidden=""></ul></skye-people-picker><div class="skye-field__message" role="alert" id="cohosts-message"></div></div><div class="skye-field" style="grid-area: photographers;"><label for="photographers">Photographer(s)</label><skye-people-picker data-field-key="photographers" id="photographers" name="Photographer_x0028_s_x0029_" aria-describedby="photographers-message" class="skye-token-picker"><div class="skye-token-picker__box"><input class="skye-token-picker__input" type="text" autocomplete="off" placeholder="Type a name or email…"></div><ul class="skye-token-picker__dropdown" hidden=""></ul></skye-people-picker><div class="skye-field__message" role="alert" id="photographers-message"></div></div><div class="skye-field" style="grid-area: attire;"><label for="attire">Attire</label><select data-field-key="attire" required="" id="attire" name="Attire" aria-describedby="attire-message"><option value="Casual">Casual</option><option value="Smart">Smart</option><option value="Business">Business</option><option value="Formal">Formal</option><option value="Machinery, Work-Safe">Machinery, Work-Safe</option><option value="See Description">See Description</option></select><div class="skye-field__message" role="alert" id="attire-message"></div></div><div class="skye-field" style="grid-area: categories;"><label for="categories">Categories</label><skye-multi-select data-field-key="categories" id="categories" name="Categories" aria-describedby="categories-message" class="skye-multi-select"><button type="button" class="skye-multi-select__trigger" aria-haspopup="listbox" aria-expanded="false"><span class="skye-multi-select__placeholder">Select options…</span><span class="skye-multi-select__caret">▾</span></button><ul class="skye-multi-select__panel" role="listbox" aria-multiselectable="true" hidden=""><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Art, Design</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Building, Fabrication</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Sports, Outdoors</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Board, Card Games</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Video Games</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Education, Learning</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Coding, Development</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Movies, TV</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Other</span></li></ul></skye-multi-select><div class="skye-field__message" role="alert" id="categories-message"></div></div><div class="skye-field" style="grid-area: studentSuccessDomain;"><label for="studentSuccessDomain">Student Success Domain</label><skye-multi-select data-field-key="studentSuccessDomain" id="studentSuccessDomain" name="StudentSuccessDomain" aria-describedby="studentSuccessDomain-message" class="skye-multi-select"><button type="button" class="skye-multi-select__trigger" aria-haspopup="listbox" aria-expanded="false"><span class="skye-multi-select__placeholder">Select options…</span><span class="skye-multi-select__caret">▾</span></button><ul class="skye-multi-select__panel" role="listbox" aria-multiselectable="true" hidden=""><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Basic Needs</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Well-Being</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Help-Seeking Behavior</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Academic Pathway</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Career Experience</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Post-graduate Plan</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Community</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Relationships</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Cultural Competence</span></li></ul></skye-multi-select><div class="skye-field__message" role="alert" id="studentSuccessDomain-message"></div></div><div class="skye-field" style="grid-area: naceCompetencies;"><label for="naceCompetencies">NACE Competencies</label><skye-multi-select data-field-key="naceCompetencies" id="naceCompetencies" name="NACECompetencies" aria-describedby="naceCompetencies-message" class="skye-multi-select"><button type="button" class="skye-multi-select__trigger" aria-haspopup="listbox" aria-expanded="false"><span class="skye-multi-select__placeholder">Select options…</span><span class="skye-multi-select__caret">▾</span></button><ul class="skye-multi-select__panel" role="listbox" aria-multiselectable="true" hidden=""><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Career &amp; Self Development</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Communication</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Critical Thinking</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Leadership</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Professionalism</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Technology</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Equity &amp; Inclusion</span></li><li class="skye-multi-select__option" role="option" aria-selected="false"><input type="checkbox"><span>Teamwork</span></li></ul></skye-multi-select><div class="skye-field__message" role="alert" id="naceCompetencies-message"></div></div><div class="skye-field" style="grid-area: studentImpact;"><label for="studentImpact">Student Impact, Event Goals and Purpose</label><textarea data-field-key="studentImpact" required="" rows="6" id="studentImpact" name="StudentImpact_x002c_EventGoalsan" aria-describedby="studentImpact-message"></textarea><div class="skye-field__help">Please explain how your event will help build community and/or develop leadership skills within the Luddy LLC.</div><div class="skye-field__message" role="alert" id="studentImpact-message"></div></div></div><div class="skye-form__page" data-page-key="purchases" style="display: none; grid-template-columns: repeat(1, 1fr); gap: 1.5rem; grid-template-areas: &quot;requiresPurchases&quot; &quot;purchaseTable&quot;;"><div class="skye-field" style="grid-area: requiresPurchases;"><fieldset data-field-key="requiresPurchases" id="requiresPurchases" name="RequiresPurchases" aria-describedby="requiresPurchases-message"><legend>Requires Purchases</legend><label><input type="radio" name="RequiresPurchases" value="Yes">Yes</label><label><input type="radio" name="RequiresPurchases" value="No">No</label></fieldset><div class="skye-field__message" role="alert" id="requiresPurchases-message"></div></div><div class="skye-field" style="grid-area: purchaseTable; display: none;"><label for="purchaseTable">Purchase Table</label><skye-lookup-table data-field-key="purchaseTable" id="purchaseTable" name="purchaseTable" aria-describedby="purchaseTable-message" class="skye-lookup-table"><table><thead><tr><th>Title</th><th>Store</th><th>Link to Item</th><th>Price per Unit</th><th>Quantity</th><th></th></tr></thead><tbody></tbody></table><button type="button">Add row</button></skye-lookup-table><div class="skye-field__message" role="alert" id="purchaseTable-message"></div></div></div><div class="skye-form__page" data-page-key="approval" style="display: none; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; grid-template-areas: &quot;statusHeading statusHeading&quot; &quot;status purchaseStatus&quot; &quot;beInvolvedHeading beInvolvedHeading&quot; &quot;hostEmail hostEmail&quot; &quot;attendanceCode beInvolvedEventId&quot; &quot;reviewer reviewer&quot; &quot;actionsHeading actionsHeading&quot; &quot;approvalComments approvalComments&quot;;"><div class="skye-field skye-field--content" style="grid-area: statusHeading;"><h3 data-field-key="statusHeading">Current Status</h3></div><div class="skye-field" style="grid-area: status;"><label for="status">Status</label><select data-field-key="status" id="status" name="Status" aria-describedby="status-message"><option value="Draft">Draft</option><option value="Submitted">Submitted</option><option value="Approved">Approved</option><option value="Denied">Denied</option></select><div class="skye-field__message" role="alert" id="status-message"></div></div><div class="skye-field" style="grid-area: purchaseStatus;"><label for="purchaseStatus">Purchase Status</label><select data-field-key="purchaseStatus" id="purchaseStatus" name="PurchaseStatus" aria-describedby="purchaseStatus-message"><option value="Not Purchased">Not Purchased</option><option value="Ordered">Ordered</option><option value="Partially Received">Partially Received</option><option value="Received">Received</option></select><div class="skye-field__message" role="alert" id="purchaseStatus-message"></div></div><div class="skye-field skye-field--content" style="grid-area: beInvolvedHeading;"><h3 data-field-key="beInvolvedHeading">BeInvolved Data</h3></div><div class="skye-field" style="grid-area: hostEmail;"><label for="hostEmail">Host campus email</label><input data-field-key="hostEmail" type="text" inputmode="email" id="hostEmail" name="hostEmail" aria-describedby="hostEmail-message"><div class="skye-field__help">The host's @iu.edu email. Used as the BeInvolved event submitter — the people picker on Metrics stores a directory ID, not an email address.</div><div class="skye-field__message" role="alert" id="hostEmail-message"></div></div><div class="skye-field" style="grid-area: attendanceCode;"><label for="attendanceCode">Attendance Scanner Access Code</label><input data-field-key="attendanceCode" type="text" readonly="" id="attendanceCode" name="AttendanceScannerAccessCode" aria-describedby="attendanceCode-message"><div class="skye-field__help">Filled in automatically once the event is approved and created in BeInvolved.</div><div class="skye-field__message" role="alert" id="attendanceCode-message"></div></div><div class="skye-field" style="grid-area: beInvolvedEventId;"><label for="beInvolvedEventId">BeInvolved Event Id</label><input data-field-key="beInvolvedEventId" type="text" readonly="" id="beInvolvedEventId" name="BeInvolved_x0020_Event_x0020_Id" aria-describedby="beInvolvedEventId-message"><div class="skye-field__message" role="alert" id="beInvolvedEventId-message"></div></div><div class="skye-field" style="grid-area: reviewer;"><label for="reviewer">Notify in Teams (pick yourself)</label><skye-people-picker data-field-key="reviewer" id="reviewer" name="reviewer" aria-describedby="reviewer-message" class="skye-token-picker"><div class="skye-token-picker__box"><input class="skye-token-picker__input" type="text" autocomplete="off" placeholder="Type a name or email…"></div><ul class="skye-token-picker__dropdown" hidden=""></ul></skye-people-picker><div class="skye-field__help">A Teams group chat is created with this person and the host to deliver the decision. Pick yourself so the chat can be created.</div><div class="skye-field__message" role="alert" id="reviewer-message"></div></div><div class="skye-field skye-field--content" style="grid-area: actionsHeading;"><h3 data-field-key="actionsHeading">Approval Actions</h3></div><div class="skye-field" style="grid-area: approvalComments;"><label for="approvalComments">Enter comments to be sent to the host and cohosts</label><textarea data-field-key="approvalComments" rows="5" id="approvalComments" name="ProposalResponseText" aria-describedby="approvalComments-message"></textarea><div class="skye-field__message" role="alert" id="approvalComments-message"></div></div></div><button type="button" class="skye-form__submit">Submit</button></div>

    </div>
    <output class="skye-form__status" data-el="status"></output>
  </section>

</BaseLayout>