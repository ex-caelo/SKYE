# Copy to `.env` and fill in as needed. All vars are build-time / client-inlined,
# so they MUST be prefixed PUBLIC_ (Astro/Vite only exposes those to the browser).

# Dev/test only: use fixture data instead of real Microsoft Graph + MSAL sign-in.
# PUBLIC_MOCK_GRAPH=1

# Azure app registration (client) id to fall back to when a link has no
# ?applicationId=. Needed for the site switcher in that case.
# PUBLIC_DEFAULT_APPLICATION_ID=00000000-0000-0000-0000-000000000000

# Entra tenant id to fall back to when a link has no ?tenantId=.
# OPTIONAL: without it, a single-tenant deployment asks the user for their work
# email on first sign-in and remembers the tenant after that (self-heals).
# Set it to skip that prompt. Get the GUID from:
#   https://login.microsoftonline.com/<your-domain>/v2.0/.well-known/openid-configuration
#   -> the "issuer" field is https://login.microsoftonline.com/<TENANT_GUID>/v2.0
# PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Set to 1 ONLY if the Azure app registration is genuinely multi-tenant: then
# auth tries the /common endpoint when no tenant is known, instead of prompting
# for a work email. Leave unset for a single-tenant registration (/common is
# rejected with AADSTS50194 there).
# PUBLIC_AUTH_ALLOW_COMMON=1
