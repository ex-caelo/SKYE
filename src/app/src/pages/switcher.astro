---
// The site-switcher page: reached directly (with ?applicationId=), or via
// a redirect from entry-form.ts when /form can't resolve a route (no
// siteId yet). entry-switcher.ts picks which screen below is visible and
// fills its data-driven parts; the markup all lives here / in the
// composed components.
import BaseLayout from "../layouts/BaseLayout.astro";
import SitePicker from "../components/SitePicker.astro";
import AddSitePanel from "../components/AddSitePanel.astro";
import FormOrViewPicker from "../components/FormOrViewPicker.astro";
import PermissionsStep from "../components/PermissionsStep.astro";
import CreateSiteAssetsStep from "../components/CreateSiteAssetsStep.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
---

<BaseLayout title="SKYE — Choose a site">
  <p data-state id="skye-loading" role="status">Loading…</p>

  <SitePicker>
    <AddSitePanel />
  </SitePicker>

  <FormOrViewPicker />
  <PermissionsStep />
  <CreateSiteAssetsStep />

  <section data-state id="state-config-missing" hidden>
    <h1>Couldn't show the switcher</h1>
    <p>No application is configured. Set <code>PUBLIC_DEFAULT_APPLICATION_ID</code> or include <code>?applicationId=</code> in the URL.</p>
  </section>

  <section data-state id="state-not-set-up" hidden>
    <h1>SKYE isn't set up here yet</h1>
    <p>This site's Site Assets library has no <code>skye_data/config/skye.config.json</code>.</p>
  </section>

  <section data-state id="state-error" hidden>
    <p>Something went wrong loading the switcher. Check the console for details.</p>
  </section>

  <ConfirmDialog />

  <script src="../scripts/entry-switcher.ts"></script>
</BaseLayout>
